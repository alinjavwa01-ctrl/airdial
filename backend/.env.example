# Model gateway. Customers pick an AirDial mode (best / fast); the gateway maps
# each mode to a model per provider and fails over in AIRDIAL_PROVIDERS order.
# A provider is skipped unless it has both a key and a model for the mode.
AIRDIAL_PROVIDERS=anthropic,openai
ANTHROPIC_API_KEY=
MODEL_BEST_ANTHROPIC=claude-opus-5-5
MODEL_FAST_ANTHROPIC=claude-sonnet-5-5
EFFORT_BEST=medium
EFFORT_FAST=low
# Backup provider (optional)
OPENAI_API_KEY=
MODEL_BEST_OPENAI=
MODEL_FAST_OPENAI=
# Prices for models not built in, $ per million tokens: model:input:output,...
AIRDIAL_PRICES=
AIRDIAL_MAX_TOKENS=16000
# Monthly model spend cap per user in USD (0 = no cap)
AIRDIAL_MONTHLY_COST_CAP_USD=12

# Auth: comma-separated token:user_id pairs for the beta.
# Replace with Supabase Auth JWT verification before public launch.
AIRDIAL_TOKENS=dev-token:njavwa

# Database: SQLite locally, Supabase Postgres in prod
# e.g. postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./airdial_agent.db

# WhatsApp Cloud API (AirDial's WhatsApp Business numbers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Template used for follow-ups outside the 24-hour window
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
